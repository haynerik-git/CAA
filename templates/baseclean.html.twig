    const idComparator = (a, b) => a === b;
    const toggleElement = (arr, val, compFn = idComparator) => {
        const res = arr.filter(v => !compFn(v, val));
        if (res.length === arr.length) res.push(val);
        return res;
    };


    function toggleValueInArray(array, value) {
        var index = array.findIndex(p => p.id == value.id);

        if (index === -1) {
            array.push(value);
        } else {
            if ( array[array.length - 1].id == value.id) {
                array.splice(index, 1);
            }
            else {
                array.push(value);
            }
        }
        return array
    }





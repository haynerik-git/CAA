{#{% set action = "actionWord" %}#}
{#{% set sentence = sentence ~ ' ' ~ word.getWordTranslationsByLang(app.session.get('lang'))  %}#}
<div class="box cell image-checkbox"
     onclick='{{ action }}("{{ loop.index }}", "", 0, 1);
             $(this).toggleClass("image-checkbox-checked")
             '
     data-wordId="{{ word.id }}"
     data-wordName="{{ word.getTranslationsByLang(app.session.get('lang')) }}"
     data-catId="{{ cat.id }}"
    >

    <div class="containerImage" style="background:
    {% if word.getBackgroundCell() is not null %}
                {{ word.getBackgroundCell() }};
    {% endif %}">
        <img src="{{ asset('images/' ~ word.filename) }}" style="max-height:13.5vh"/>
        <span>
            {{ word.getTranslationsByLang(app.session.get('lang')) }}
        </span>
    </div>
{#    <i class="material-icons">select_check_box</i>#}

                <form>
                    <label for="lang">Choise you language {{ app.session.get('lang') }}:</label>
                    <select class="" id="lang"  onchange="setLang(this);">
                        <option {% if ( app.session.get('lang') == 2) %}selected{% endif %} value="2">es</option>
                        <option {% if ( app.session.get('lang') == 1) %}selected{% endif %} value="1">fr</option>
                        <option {% if ( app.session.get('lang') == 4) %}selected{% endif %} value="4">cat</option>
                        <option {% if ( app.session.get('lang') == 3) %}selected{% endif %} value="3">en</option>
                        <option {% if ( app.session.get('lang') == 5) %}selected{% endif %} value="5">de</option>
                    </select>


                    <label for="speakOnClick">Speak on touch :</label>
                    <input type="checkbox" data-role="flipswitch" name="speakOnClick" id="speakOnClick">

                    <label for="robotVoice">Robot Voice :</label>
                    <input type="checkbox" data-role="flipswitch" name="robotVoice" id="robotVoice">
                </form>
            </div>
        </div>




        }



    </style>
{% set words = [] %}
    <div id="hotPart">
        {% include('/index/menu/menuHome.html.twig') %}
        <div id="grid-container"  >
            {% for words in wordsResult %}
                {% for word in words %}
                    {% if word.getClassName == 'Word' %}
                        {{ word.getWordTranslationsByLang(app.session.get('lang')) }}
                    {% elseif word.getClassName == 'Page' %}
                        {% if word.isAddHasWord %}
                            {{ word.getTranslationsByLang(app.session.get('lang')) }}
                        {% endif %}
                    {% endif %}
                {% endfor %}
<br>

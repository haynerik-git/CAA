        reloadResizeImage()
    }

    function reloadResizeImage() {
        console.log('----------------------')
        $(document).find('.containerImage').each(function () {
            const container = this,
                $container = $(this),
                $image = $container.find('img'),

                factor = 0.1,
                maxScale = 6;
            console.log($image)
            let previousX = 0,
                previousY = 0,
                scale = 1;
            $image.draggable({ scroll: true });
            $container.on('mousedown', function (e) {
                e.preventDefault();
                previousX = e.pageX;
                previousY = e.pageY;
            });
            $container.on('mousemove', function (e) {
                if (e.buttons) {
                    let dragX = 0,
                        dragY = 0;
                    if (e.pageX - previousX !== 0) {
                        dragX = previousX - e.pageX;
                        previousX = e.pageX;
                    }
                    if (e.pageY - previousY !== 0) {
                        dragY = previousY - e.pageY;
                        previousY = e.pageY;
                    }
                    // if (dragX !== 0 || dragY !== 0) {
                    //     container.scrollBy(dragX, dragY);
                    //     console.log(`scrollBy(${dragX}, ${dragY});`);
                    // }
                }
            });
            $container.on('wheel', function (e) {
                e.preventDefault();
                let delta = getDelta(e.originalEvent),
                    mouse = {
                        x: e.pageX - e.target.offsetLeft,
                        y: e.pageY - e.target.offsetTop
                    },
                    offset = {
                        x: container.scrollLeft,
                        y: container.scrollTop
                    },
                    imageLoc = {
                        // x: e.pageX + offset.x,
                        // y: e.pageY + offset.y
                        x: mouse.x + offset.x,
                        y: mouse.y + offset.y
                    },
                    zoomPoint = {
                        x: imageLoc.x / scale,
                        y: imageLoc.y / scale
                    };
                console.log(`delta: ${delta}`);
                scale += delta * factor * scale;
                scale = clamp(scale, 0.1, maxScale);
                let newZoomPoint = {
                    x: zoomPoint.x * scale,
                    y: zoomPoint.y * scale
                };
                let newScroll = {
                    // x: newZoomPoint.x - e.pageX,
                    // y: newZoomPoint.y - e.pageY
                    x: newZoomPoint.x - mouse.x,
                    y: newZoomPoint.y - mouse.y
                };
                console.log(`mouse: ${mouse}`);
                console.log(`Scale: ${scale}`);
                $image.css('transform', `scale(${scale})`);
                container.scrollTop = newScroll.y;
                container.scrollLeft = newScroll.x;
                console.log(`Scroll: ${container.scrollTop}x${container.scrollLeft}`);
            });
        });


        function clamp(value, min, max)
        {
            return Math.max(min, Math.min(max, value));
        }

        function getDelta(event) {
            let delta = event.delta || event.wheelDelta || -event.deltaY;
            if(delta === undefined) {
                delta = event.originalEvent.detail;
            }
            console.log(delta);
            return clamp(delta, -1, 1);
        }


    }


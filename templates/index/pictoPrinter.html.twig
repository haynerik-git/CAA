          href="css/theme/jquery-ui-1.12.icon-font.min.css" />
    <style>
        :root {
            --column: 5;
            --row: 5;
            --background: #000;
            --backgroundCell: #fff;
            --backgroundTab: #000;
            --border:red;
            --colorDescription: #000;
            --tabsPosition:0;
            --nbTabs: 7;
            --colorTextTab: #fff;
            --headerHeight:1.2cm;
            --margeTop: 1.5cm;
            --fontFamily:arial;

        }


        @page {
            size: 29.7cm 21cm ;
            background: var(--background);
            background-repeat: no-repeat;
            background-position: center;
           .page {
            position: relative;
            display: flex;
            flex-direction: column;
           }
            /*.grid-cell {*/
            /*    background: var(--background);*/
            /*}*/
            /*margin: 30mm 45mm 30mm 45mm;*/
            /* change the margins as you want them to be. */
            .notPrint {
                display: none !important;
            }

        }

        @media print {
            body {
                height: 21cm;
                width: 29.7cm;
                background: #fff;
                /*padding: 2cm 0 0 0;*/
                /*padding: 5% 0mm 0mm 0mm;*/

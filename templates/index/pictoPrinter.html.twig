                /* change the margins as you want them to be. */
            }

            .notPrint {
                display: none !important;
            }

            .margeTop {
                height: var(--margeTop);
                order: 0 !important;
                display: block !important;
            }

            .ongletContainer {
                order: 2 !important;
                height: var(--headerHeight);
            }

            .grid-container {
                order: 1 !important;
                height: 100%;
                background: var(--background);
            }

            .onglet {
                height: 100% ;
                /*height: 20%;*/
                background: var(--backgroundTab);
                color: #fff;
                /* padding: 15px; */
                width: calc(100% / var(--nbTabs));
                margin-left: calc( (100% / var(--nbTabs) ) * var(--tabsPosition));
                align-content: center;
                justify-content: center;
                align-items: center;
                text-align: center;
                border-radius: 0 0 10px 10px !important;
            }

            input {
                /*border: none;*/
            }
        }

        body {
            margin: 0;
        }
        .page {
            background: var(--background);
            background-size:100%;
            height: 21cm;
            width: 29.7cm;
            margin: 0 auto;
            position: relative;
            display: flex;
            flex-direction: column;
            margin-bottom: 20px;
        }
        .header {
            display: table-header-group;
        }
        .margeTop{
            height: var(--margeTop);
            order: 5;
            /*display: none;*/
        }
        .ongletContainer {
            width: 29.7cm;
            margin: 0 auto;
            background: #fff;
            order:1;
            height: var(--headerHeight);
            .remove {
                display: none;
            }
            &:hover .remove {
                display: block;
                position: absolute;
                top: 0;
                /*left: 0;*/
                right: 0;
                border-radius: 50%;
                width: 50px;
                height: 50px;
                z-index: 1;
            }
        }
        .onglet {
            height: 100% ;
            background: var(--backgroundTab);
            color: #fff;
            /* padding: 15px; */
            width: calc(100% / var(--nbTabs));
            margin-left: calc( (100% / var(--nbTabs) ) * var(--tabsPosition));
            align-content: center;
            justify-content: center;
            align-items: center;
            text-align: center;
            border-radius: 10px 10px 0px 0px;
        }

        #tabName {
            border:none;
            background: transparent;
            color:var(--colorTextTab);
            font-weight: 600;
            font-family: var(--fontFamily);
            font-size: 26px;
            text-align: center;
            max-width: 100%;
        }

        .grid-container {
            order:2;
            /*&::first-child{*/
            /*    height: calc(21cm - var(--headerHeight));*/
            /*}*/
            height:calc(21cm - ( calc(var(--headerHeight) + var(--margeTop))));

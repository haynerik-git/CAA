            /*border: 1px solid red;*/
            /*background: darkred;*/
            display: flex;
            flex-wrap: wrap;
            align-content: flex-start;
            margin: 0 auto;

        }

        .grid-cell {
            padding: 10px;
            position: relative;
            box-sizing: border-box;
            /*background: darkblue;*/
            flex-basis: calc(100% / var(--column));
            height: calc(100% / var(--row));
            color: white;
            text-align: center;
            /*transition: all 0.3s ease;*/
            display: flex;
            align-content: center;
            flex-direction: column;
            justify-content: center;
            max-width: calc(100% / var(--column));
            cursor: move;
            /*background: var(--background);*/
            .remove {
                display: none;
            }
            /*&:nth-child(n+25) {*/
            /*    display:none*/
            /*}*/
        }



        .grid-cell:hover {
            /*background: rgba(0,0,139,0.5);*/
            .remove {
                display: block;
                position: absolute;
                top: 0;
                /*left: 0;*/
                right: 0;
                border-radius: 50%;
                width: 50px;
                height: 50px;
                z-index: 1;
            }
        }

        .imgPrint {
            height: -webkit-fill-available;
            width: fit-content;
            align-self: center;
            max-width: 100%;
        }
        @media print {
            .page, .page-break { break-after: page; }
        }

        #btn-form {
            position: absolute;
            top: 0;
            width: 100px;
            height: 40px;
            left: 45%;
            border: 0;
            background: none;
        }
        .containerImage {
            background: var(--backgroundCell);
            height:100%;
            /*margin: 0px 5px 0;*/
            border: 4px solid var(--border);
            border-radius: 10px 10px 0 0;
            border-bottom: none;
            /*width: 450px;*/
            /*height: 450px;*/
        /*// margin-left: 450px;*/
            overflow: scroll;
            transform-origin: 0 0;
            scrollbar-width: none;
            -ms-overflow-style: none;
            cursor: crosshair;
            &::-webkit-scrollbar {
                width: 0;
                height: 0;
            }
            img {
                height: auto;
                max-height: 100%;
                width: auto;
                align-self: center;
                /*max-width: 100%;*/
                transform-origin: 0 0;
            }
        }
        p {
            margin: 0;
            color: #000;
        }

        .description{
            border:none;
            text-align: center;
            background: var(--backgroundCell);
            border: 4px solid var(--border);
            border-radius: 0 0 10px 10px ;
            border-top: none;
            font-weight: 600;
            font-family: var(--fontFamily);
            font-size: 20px;
            color: var(--colorDescription);
        }


        .drop-zone {
            height: 97%;
            border: 2px dashed #007bff;
            border-radius: 4px;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: #007bff;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .drop-zone {
            /*max-width: 200px;*/
            height: 95%;
            /*padding: 25px;*/
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            /*font-family: "Quicksand", sans-serif;*/
            font-weight: 500;
            font-size: 20px;
            cursor: pointer;
            color: #cccccc;
            border: 4px dashed #009578;
            border-radius: 10px;
        }

        .drop-zone--over {
            border-style: solid;
        }

        .drop-zone__input {
            display: none;
        }

        .drop-zone__thumb {
            width: 100%;
            height: 100%;
            border-radius: 10px;
            overflow: hidden;
            background-color: #cccccc;
            background-size: cover;
            position: relative;
        }

        .drop-zone__thumb::after {
            content: attr(data-label);
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            padding: 5px 0;
            color: #ffffff;
            background: rgba(0, 0, 0, 0.75);
            font-size: 14px;
            text-align: center;
        }

        .btn-upload {
            height: 100%;
            top: 14%;
            position: relative;
        }

        .menuForm {
            background: #c3c3c3;

    var r = document.querySelector(':root');

    // Create a function for getting a variable value
    function myFunction_get() {
        // Get the styles (properties and values) for the root
        var rs = getComputedStyle(r);
        // Alert the value of the --blue variable
        // alert("The value of --blue is: " + rs.getPropertyValue('--blue'));
    }

    // Create a function for setting a variable value
    function myFunction_set(key,value) {
        // Set the value of variable --blue to another value (in this case "lightblue")
        r.style.setProperty(key, value);
    }

    function myFunction_setAjax(key,value) {
        // Set the value of variable --blue to another value (in this case "lightblue")
        r.style.setProperty(key, value);

        $.ajax({
            method: "POST",
            url: "/pageEditor/updateValue",
            data: {id: {{ page.id }}, key:  key , value: value}
        })
            .done(function (msg) {
                // $(document).find('#' + current.id ).parent().remove()

            });
    }

function toggleDrag() {
    $(".grid-container").sortable("destroy");


    if($("#drag").is(':checked')) {
        $(document).find('.grid-cell').removeClass('state-disabled')
    }else{
        $(document).find('.grid-cell').addClass('state-disabled')
    }
        // $('.grid-cell').toggleClass('state-disabled')

    // alert(typeLoaded)
    var typeLoaded = $('#typeLoaded').val()
    if( typeLoaded == 'page') {
        var url = "/pageEditor/updatePageOrder"
    } else {
        var url = "/pageEditor/updateCategorieOrder"
    }

    // $(".grid-container").sortable("enable");
    $(".grid-container").sortable({
        opacity: 0.6,
        cursor: 'move',
        items: ".grid-cell:not(.state-disabled)",
        update: function(event, ui) {
            var dat = $('#grid-container .grid-cell ')
            var index = 0
            var order = []
                dat.each(function(i) {
                    order[index] = {'pageOrderId' : $(this).attr('data-id'), 'catId' : $(this).attr('data-catId')}
                    index++
                })
            console.log(order)
            $.ajax({
                method: "POST",
                url: url,
                data: { 'order' : order }
            })
                .done(function( msg ) {
                    // alert( "Data Saved: " + msg );

                });

    console.log(order)
        },
        // cancel: ".ui-state-disabled"
    });

    }

    function openTab(evt, cityName) {
        // Declare all variables
        var i, tabcontent, tablinks;

        // Get all elements with class="tabcontent" and hide them
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }

        // Get all elements with class="tablinks" and remove the class "active"
        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }

        // Show the current tab, and add an "active" class to the link that opened the tab
        document.getElementById(cityName).style.display = "block";
        evt.currentTarget.className += " active";
    }

</script>

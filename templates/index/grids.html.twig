        ///////////

        .image-checkbox {
            cursor: pointer;
            box-sizing: border-box;
            -moz-box-sizing: border-box;
            -webkit-box-sizing: border-box;
            border: 3px solid transparent;
            box-shadow: 0 0 4px #ccc;
            outline: 0;
            margin: 4px;
            border-radius: 12px;
        }

        .image-checkbox-checked {
            border-color: #2196f3;
        }


        .image-checkbox i {
            display: none;
            color: darkgreen !important;
        }

        .image-checkbox-checked {
            position: relative;
        }


        .image-checkbox-checked i {
            display: block;
            position: absolute;
            top: 0;
            right: 0;
            z-index: 1;
        }







        /*  dirty tabs */
        ul {
            display: flex;
            padding: 0;
        }

        ul li {
            /*this instruction means "To split space between all 'li' elements evenly*/
            flex: 1;
            list-style-type: none;
            text-align: center;
            a.active{
                background: red;
            }
        }


        /* tabBox */
        #tabBox {
            width: 100%;
            height: auto;
            margin: 0 auto;
            position: relative;
        }
        .tabWrap {
            float: none;
        }


        /* Tabs */

            #tabBox {
                display: flex;
            }
            .tabWrap {
                flex:1;
                text-align: center;
                display: flex;
            }
            .tab {
                padding: 1rem;
                flex-grow: 1;
                width: 50%;
                height: auto;
                margin: 0;
                /*border-right: 15px solid transparent;*/
                background: black;
                color: white;
                position: relative;
                cursor: pointer;
                -webkit-transition: all 0.2s ease-in-out;
                -moz-transition: all 0.2s ease-in-out;
                -ms-transition: all 0.2s ease-in-out;
                -o-transition: all 0.2s ease-in-out;
                transition: all 0.2s ease-in-out;
            }
            .active {
                .tab {
                    background:  #f0f0f0;
                    font-weight: bold;
                    color: black;
                    /*border-right: 15px solid transparent;*/
                }
            }





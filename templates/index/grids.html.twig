    <style>
        body {
            font-family: sans-serif;
            justify-content: center;
            align-items: center;
            min-height: 100%;
            margin: 0;    padding-bottom: 30px;
            background-color: #f0f0f0;
            padding-bottom: 130px;
        }

        .header {
            height: 10vh;
            display:grid;
            background-color: #fff;
            place-items: center;
        }

        .container2 {
            /*border-radius: 1vw; !* Rayon de bordure basé sur la largeur de la fenêtre *!*/
            width: 100vw;
            height: auto;
            box-sizing: border-box;
            overflow-y: auto;
            /* box model properties */
            /*padding: 10px;*/
            /* display properties */
            display: flex;
            place-items: center;
            /*gap: 2vh 2vw;*/
            overflow: scroll;
            -webkit-overflow-scrolling:touch;
            -ms-overflow-style: none;  /* Internet Explorer 10+ */
            scrollbar-width: none;  /* Firefox */
            /*.active{*/
            /*    background: linear-gradient(45deg, black, transparent);*/
            /*}*/
            a {
                max-height: 15svh;
            }
        }
        ::-webkit-scrollbar {
            width: 0;  /* Remove scrollbar space */
            background: transparent;  /* Optional: just make scrollbar invisible */
        }
        /* Optional: show position indicator in red */
        ::-webkit-scrollbar-thumb {
            background: #FF0000;
        }

        .container {
            width: 100vw;
            height: auto;
            box-sizing: border-box;
            /*overflow-y: auto;*/
            /* box model properties */
            padding: 10px;
            /* display properties */
            display: grid;
            place-items: center;
            gap: 2vh 2vw;
        }

        .row {
            display: contents;
        }

        .fixedColumn {
            display: flex;
            flex-direction: column;
            text-align: center;
        }
        .cell, .hero {
            background-color: #fff;
            text-align: center;
            border-radius: 1vw; /* Rayon de bordure basé sur la largeur de la fenêtre */
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: stretch;
            box-sizing: border-box;
            margin: 1rem 0.5rem;
            width: 100%;
            height: 100%;
            position: relative;
            overflow: hidden;
            min-height: 120px;
            min-width: 100px;
            outline: 1px solid #ff0000;
            transition: outline 1s ease 0s;
            place-content: center;


            &.active {

                outline: 10px solid #ffff00;
            }

            /*background: url("https://i.postimg.cc/g0qSVBP9/alfa-romeo-2-wallpaper-1600x1200.jpg")*/
            /*no-repeat;*/
            /*background-size: 100% 100%;*/
            /*background-position: cover;*/
        }

        .cell img {
            position: relative;
            /*margin: 0 auto;*/
            text-align: center;
            align-items: center;
            justify-content: center;
            display: flex;
            width: auto;
            /*border-radius: 10px;*/
            /*width: fit-content;*/
            height: fit-content;
            max-width: -webkit-fill-available;
            max-height: 18vh;
            /*   max-width: 5vw;Taille de l'image basée sur la largeur de la fenêtre */
            /*max-height: 80%; !* Taille de l'image basée sur la hauteur de la fenêtre *!*/
            margin-bottom: 0.5vh; /* Marge inférieure basée sur la hauteur de la fenêtre */
            /*position: absolute;*/

        }
        /*.cell:before{*/
        /*    position: absolute;*/
        /*    content: "";*/
        /*    top: 0;*/
        /*    left: 0;*/
        /*    width: 100%;*/
        /*    height: 100%;*/
        /*    background: url("https://i.postimg.cc/xC1RKfRH/splash.jpg") no-repeat;*/
        /*    background-size: 100% 100%;*/
        /*    background-position: center;*/
        /*    mix-blend-mode: screen;*/
        /*}*/

        .cell span {
            bottom: 0px;
            position: absolute;
            background: linear-gradient(-20deg, #bb7413, #e7d25c);
            width: 100%;
            padding: 1vw 0;
            font-size: small;
            color: #fff;
            font-weight: bold;
        }

        .continue {
            .pushable:focus:not(:focus-visible) {
                outline: none;
            }
            position: fixed;
            bottom: 80px;
            text-align: center;
            width: 100%;
            display: none;
            .pushable {
                width: 80%;
                background: hsl(340deg 100% 32%);
                border-radius: 12px;
                border: none;
                padding: 0;
                cursor: pointer;
                outline-offset: 4px;
            }
            .front {
                display: block;
                padding: 12px 42px;
                border-radius: 12px;
                font-size: 1.25rem;
                background: hsl(345deg 100% 47%);
                color: white;
                transform: translateY(-6px);
            }

            .pushable:active .front {
                transform: translateY(-2px);
            }
        }
        .footer {
            position: fixed;
            bottom: 0;
            grid-template-columns: repeat(16, 1fr);
            width: 100%;
            place-items: center;
            .box:nth-child(2) {
                grid-column: span 8;
                height: 100%;
            }
            .box {
                grid-column: span 4;
                width: 100%;
                height: 100%;
            }
        }

        .header {
            grid-template-columns: repeat(14, 1fr);
            .box:nth-child(3) {
                grid-column: span 6;
                height: 100%;
            }
            .box {
                grid-column: span 2;
                width: 100%;
                height: 100%;
            }
        }
        .containerSentence2column {
            display: flex;
            flex-wrap: wrap;
        }

        .sentence {
            flex-basis: calc(100% - 2rem);
            box-sizing: border-box;
            align-self: center;
        }
        @media screen and (min-width:769px) {
            .sentence {
                flex-basis: calc(50% - 2rem);
                box-sizing: border-box;
            }
        }

        @media screen and (min-width:1200px)  {
            .sentence{
                flex-basis: calc(20% - 2rem);
                box-sizing: border-box;
            }
        }

        .containerSentence{
            display: grid;
            grid-template-columns: repeat(1, 1fr) !important;
        }
        /* Mobile View */
        @media screen and (min-width:250px) and (max-width:480px) {
            .container{
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* Tablet View */
        @media screen and (min-width:481px) and (max-width:768px) {
            .container{
                grid-template-columns: repeat(4,1fr);
            }
        }
        /* Laptop View */
        @media screen and (min-width:769px)  {
            .container{
                grid-template-columns: repeat(5,1fr);
            }
        }


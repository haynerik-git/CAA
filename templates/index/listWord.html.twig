{% block body %}
    {% set id = 9999999 %}
    {% set action = "removeWord" %}
    {% set sentence = "" %}
{#    {{ words | length }}#}
    <div class='owl-carousel owl-theme owl-carousel-words' style="    display: -webkit-inline-box;overflow: scroll;">
        {% for word in words %}
            {% if word.getClassName == 'Word' %}
{#            <? echo get_class(word) ?>#}
                {% include '/wordsSmall.html.twig' %}
                {% set sentence = sentence ~ " " ~ word.getWordTranslationsByLang(app.session.get('lang'))  %}
            {% elseif word.getClassName == 'Page' %}
                {% if word.isAddHasWord %}
                    {% include '/pageSmall.html.twig' %}
{#                    {{ word.getTranslationsByLang(app.session.get('lang')) }}#}
                    {% set sentence = sentence ~ " " ~ word.getTranslationsByLang(app.session.get('lang'))  %}
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
    <input type="text" id="txt" value="{{ sentence }}" style="display:none;"></input>
    <input type="text" id="lang" value="{{ app.session.get('lang') }}" style="display:none;"></input>
{#    <script>#}

